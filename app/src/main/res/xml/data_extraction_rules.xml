<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The DataStore preferences file stores raw AI provider API keys in
             plain text (Gemini/OpenAI/Claude/DeepSeek/NVIDIA/Groq/custom).
             It must never leave the device via cloud backup. -->
        <exclude domain="file" path="datastore/user_preferences.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/user_preferences.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>
